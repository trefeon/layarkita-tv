<?xml version="1.0" encoding="utf-8"?>
<!-- Global-search entry point for the Leanback launcher and the voice
     recognizer. The label/hint surface in the system search UI; the voice
     button launches the recognizer (free-form). In-app search keeps using
     TvTextField — the stock Gboard TV layout already carries a mic key for
     plain text input, so no extra wiring is needed there. -->
<searchable xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/app_name"
    android:hint="@string/search_placeholder"
    android:voiceSearchMode="showVoiceSearchButton|launchRecognizer"
    android:voiceLanguageModel="free_form" />
